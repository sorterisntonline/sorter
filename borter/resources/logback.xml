<?xml version="1.0" encoding="UTF-8"?>
<!-- Jetty logger config -->
<!-- Options: http://logback.qos.ch/manual/layouts.html -->
<configuration scan="true" scanPeriod="5 seconds">
    <!-- Properties from environment variables -->
    <property name="LOG_PATH" value="${BORTER_LOG_PATH:-/home/deployer/logs/borter}"/>
    <property name="LOG_LEVEL" value="${BORTER_LOG_LEVEL:-INFO}"/>
    <property name="ENVIRONMENT" value="${ENVIRONMENT:-development}"/>
    <property name="PRINT_STACKTRACE" value="${BORTER_LOG_STACKTRACE:-false}"/>

    <!-- Console Appender -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>[%highlight(%-5level){ERROR=red, WARN=yellow, INFO=white, DEBUG=cyan}] %gray(%d{yyyy-MM-dd HH:mm:ss.SSS}) %boldBlue(%logger{36}) %highlight(%white(%msg)){ERROR=red, WARN=yellow}%n%ex{short}</pattern>
        </encoder>
    </appender>

    <!-- File Appender for all logs -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/borter.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/borter.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>[%-5level] %d{yyyy-MM-dd HH:mm:ss.SSS} %logger{36} %msg%n%ex{short}</pattern>
        </encoder>
    </appender>

    <!-- Error-specific File Appender -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/error.log</file>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/error.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>[ERROR] %d{yyyy-MM-dd HH:mm:ss.SSS} %logger{36} %msg%n%ex{short}</pattern>
        </encoder>
    </appender>

    <!-- Root logger catches everything at INFO level -->
    <root level="INFO">
        <appender-ref ref="STDOUT" />
        <if condition='isDefined("LOG_PATH")'>
            <then>
                <appender-ref ref="FILE" />
                <appender-ref ref="ERROR_FILE" />
            </then>
        </if>
    </root>

    <!-- Application-specific loggers - no direct appender references -->
    <logger name="app" level="${LOG_LEVEL}" />

    <!-- Set specific levels for noisy libraries -->
    <logger name="org.eclipse.jetty" level="INFO" />
    <logger name="com.zaxxer.hikari" level="INFO" />
    <logger name="org.eclipse.jetty.util.log" level="INFO" />
    
    <!-- Hyperfiddle loggers - no direct appender references -->
    <logger name="hyperfiddle" level="DEBUG" />
    <logger name="hyperfiddle.electric-jetty-adapter" level="WARN" />
</configuration>

