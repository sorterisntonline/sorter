{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.11.1"}
        org.clojure/clojurescript {:mvn/version "1.11.60"}
        org.clojure/tools.logging {:mvn/version "1.2.4"}
        org.slf4j/slf4j-api {:mvn/version "2.0.7"}
        ch.qos.logback/logback-classic {:mvn/version "1.4.11"}
        ch.qos.logback/logback-core {:mvn/version "1.4.11"}
        org.codehaus.janino/janino {:mvn/version "3.1.10"}
        cider/cider-nrepl {:mvn/version "0.47.1"}
        metosin/reitit {:mvn/version "0.7.0-alpha7"}
        ring/ring-jetty-adapter {:mvn/version "1.11.0-RC1"}
        io.staticweb/rate-limit {:mvn/version "1.1.0"}
        metosin/jsonista {:mvn/version "0.3.7"}
        hato/hato {:mvn/version "0.9.0"}
        tick/tick {:mvn/version "0.7.5" :exclusions [com.widdindustries/time-literals]}
        district0x/graphql-query {:mvn/version "1.0.6"}
        clojure-humanize/clojure-humanize {:mvn/version "0.2.2"}
        org.clojure/data.json {:mvn/version "2.4.0"}
        lambdaisland/regal {:mvn/version "0.0.143"}
        hikari-cp/hikari-cp {:mvn/version "3.0.1"}
        com.github.seancorfield/next.jdbc {:mvn/version "1.3.909"}
        com.github.seancorfield/honeysql {:mvn/version "2.5.1103"}
        org.postgresql/postgresql {:mvn/version "42.5.1"}
        crypto-password/crypto-password {:mvn/version "0.3.0"}
        instaparse/instaparse {:mvn/version "1.4.12"}
        migratus/migratus {:mvn/version "1.4.9"}
        com.hyperfiddle/rcf {:mvn/version "20220926-202227"}
        com.github.rawleyfowler/sluj {:mvn/version "1.0.2"}
        com.clojure-goes-fast/clj-async-profiler {:mvn/version "1.2.0"}
        io.github.borkdude/deflet {:mvn/version "0.1.0"}
        ring-ratelimit/ring-ratelimit {:mvn/version "0.2.3"}
        environ/environ {:mvn/version "1.2.0"} ; Corrected dependency
        clj-commons/clj-yaml {:mvn/version "1.0.29"}
        com.wsscode/pathom3 {:mvn/version "2025.01.16-alpha"}
        nrepl/nrepl {:mvn/version "1.1.1"}}
 :aliases {:dev
           {:extra-deps
            {binaryage/devtools {:mvn/version "1.0.6"}
             thheller/shadow-cljs {:mvn/version "2.20.1"}}
            :jvm-opts
            ["-Xss2m"
             "-XX:-OmitStackTraceInFastThrow"]
            :exec-fn user/main
            :exec-args {}}
           :build
           {:extra-paths ["src-build"]
            :ns-default build
            :extra-deps {io.github.clojure/tools.build {:git/tag "v0.10.7" :git/sha "573711e"}
                         io.github.seancorfield/build-clj {:git/tag "v0.9.2" :git/sha "9c9f078"}}
            :jvm-opts ["-Xss2m"]}
           :uberjar
           {:replace-deps
            {com.github.seancorfield/depstar {:mvn/version "2.1.303"}}
            :exec-fn hf.depstar/uberjar
            :exec-args {:jar "app.jar" :aot true}
            :jvm-opts ["-Dclojure.runtime=uberjar"]}}}
