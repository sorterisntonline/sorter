# borter/.env
HOSTNAME=localhost

# Linear Integration
BORTER_LINEAR_CLIENT_ID=xxx
BORTER_LINEAR_CLIENT_SECRET=xxx

# Spotify Integration
BORTER_SPOTIFY_CLIENT_ID=xxx
BORTER_SPOTIFY_CLIENT_SECRET=xxx

# Reddit Integration
BORTER_REDDIT_CLIENT_ID=xxx
BORTER_REDDIT_SECRET=xxx

# Twitter Integration
BORTER_TWITTER_KEY=xxx
BORTER_TWITTER_KEY_SECRET=xxx
BORTER_TWITTER_BEARER_TOKEN=xxx
BORTER_TWITTER_OAUTH_CLIENTID=xxx
BORTER_TWITTER_OAUTH_CLIENTSECRET=xxx

# YouTube Integration
BORTER_YOUTUBE_API_KEY=xxx
BORTER_YOUTUBE_CLIENT_ID=xxx
BORTER_YOUTUBE_CLIENT_SECRET=xxx
BORTER_YOUTUBE_REDIRECT_URIS=xxx
BORTER_YOUTUBE_JAVASCRIPT_ORIGINS=xxx

# SendGrid
BORTER_SENDGRID_API_KEY=xxx

# OpenRouter
OPENROUTER_KEY=xxx

# Environment
ENVIRONMENT=development

# Database URLs
DATABASE_URL=postgres://postgres:password@localhost:5432/postgres
# PROD_DATABASE_URL=postgres://postgres:password@localhost:5432/postgres

# Logging
BORTER_LOG_PATH=/home/deployer/logs/borter
BORTER_LOG_LEVEL=INFO
# Discord Bot Token
DISCORD_BOT_TOKEN=xxx

# Static Admins
BORTER_STATIC_ADMINS=111,222,admin,discord,spotify