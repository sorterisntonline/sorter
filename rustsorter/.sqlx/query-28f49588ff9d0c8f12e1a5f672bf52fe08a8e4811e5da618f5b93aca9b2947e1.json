  "query": "SELECT\n    parent_ns,\n    parent_pk,\n    child_ns,\n    child_pk,\n    user_id,\n    created_at\nFROM\n    entity_relationships\nWHERE ($1::text IS NULL\n    OR parent_ns = $1::text)\nAND ($2::text IS NULL\n    OR parent_pk = $2::text)\nAND ($3::text IS NULL\n    OR child_ns = $3::text)\nAND ($4::text IS NULL\n    OR child_pk = $4::text)\nAND ($5::uuid IS NULL\n    OR user_id = $5::uuid)\nORDER BY\n    created_at DESC\n",
