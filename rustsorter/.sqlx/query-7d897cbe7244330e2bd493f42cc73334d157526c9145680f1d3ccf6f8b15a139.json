  "query": "SELECT DISTINCT e.user_id, e.ns, e.pk, e.title, e.profile_picture_url, e.metadata, e.created_at\n        FROM entities e\n        JOIN entity_relationships er ON e.ns = er.parent_ns AND e.pk = er.parent_pk\n        LIMIT 50",
