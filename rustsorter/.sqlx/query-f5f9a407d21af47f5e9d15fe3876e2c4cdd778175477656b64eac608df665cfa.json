{
  "db_name": "PostgreSQL",
  "query": "SELECT e.*\nFROM entities e\nJOIN entity_relationships er ON e.ns = er.child_ns\n    AND e.pk = er.child_pk\nWHERE er.parent_ns = $1\n    AND er.parent_pk = $2\n    AND ($3::text IS NULL OR e.ns = $3)  -- pin_ns filter\n    AND ($4::text IS NULL OR e.pk = $4)           -- pin_pk filter",
