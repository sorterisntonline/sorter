{
  "db_name": "PostgreSQL",
  "query": "SELECT DISTINCT ON (entity_ns, entity_pk)\n    id,\n    user_id,\n    list_ns,\n    list_pk,\n    entity_ns,\n    entity_pk,\n    action,\n    created_at,\n    expires_at\nFROM user_list_actions\nWHERE user_id = $1\n  AND list_ns = $2\n  AND list_pk = $3\n  AND (expires_at IS NULL OR expires_at > CURRENT_TIMESTAMP)\nORDER BY entity_ns, entity_pk, created_at DESC, id DESC;\n",
