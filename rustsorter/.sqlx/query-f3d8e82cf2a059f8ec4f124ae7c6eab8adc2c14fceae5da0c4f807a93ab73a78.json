  "query": "SELECT\n    left_entity_ns,\n    left_entity_pk,\n    right_entity_ns,\n    right_entity_pk,\n    magnitude,\n    created_at\nFROM\n    votes\nWHERE (left_entity_ns || ':' || left_entity_pk) = ANY ($1)\n    AND (right_entity_ns || ':' || right_entity_pk) = ANY ($1)\n    AND deleted_at IS NULL\nORDER BY\n    created_at ASC;\n",
