  "query": "SELECT\n    left_entity_ns,\n    left_entity_pk,\n    right_entity_ns,\n    right_entity_pk,\n    user_id,\n    magnitude,\n    attribute_id,\n    created_at,\n    deleted_at\nFROM\n    votes\nWHERE\n    left_entity_ns = $1\n    AND left_entity_pk = $2\n    AND right_entity_ns = $3\n    AND right_entity_pk = $4\n    AND user_id = $5\n    AND attribute_id = $6\n    AND deleted_at IS NULL\nORDER BY\n    created_at DESC\nLIMIT 1\n",
