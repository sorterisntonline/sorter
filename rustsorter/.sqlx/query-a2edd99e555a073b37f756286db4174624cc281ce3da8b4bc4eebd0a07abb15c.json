  "query": "SELECT\n    e.*\nFROM\n    entities e\n    JOIN entity_relationships er ON e.ns = er.child_ns\n        AND e.pk = er.child_pk\nWHERE\n    er.parent_ns = $1\n    AND er.parent_pk = $2\n",
