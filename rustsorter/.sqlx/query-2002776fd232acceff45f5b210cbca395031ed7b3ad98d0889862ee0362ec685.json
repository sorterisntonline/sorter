  "query": "INSERT INTO list_behaviors(\n    parent_ns,\n    parent_pk,\n    include_by_default,\n    updated_at\n) VALUES ($1, $2, $3, now())\nON CONFLICT (parent_ns, parent_pk)\nDO UPDATE\n    SET include_by_default = EXCLUDED.include_by_default,\n        updated_at = now()\nRETURNING\n    parent_ns,\n    parent_pk,\n    include_by_default,\n    created_at,\n    updated_at;\n",
