  "query": "INSERT INTO entities(pk_namespace, pk, title, metadata, profile_picture_url, user_id)\n    VALUES ($1, $2, $3, $4, $5, $6)\nON CONFLICT (pk_namespace, pk)\nDO UPDATE SET\n    title = EXCLUDED.title,\n    metadata = EXCLUDED.metadata,\n    profile_picture_url = EXCLUDED.profile_picture_url,\n    user_id = EXCLUDED.user_id\nRETURNING\n    pk_namespace,\n    pk,\n    title,\n    metadata,\n    created_at,\n    profile_picture_url,\n    user_id\n\n\n",
