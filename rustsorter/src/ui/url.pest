WHITESPACE = _{ " " | "\t" | "\n" | "\r" }

url = { SOI ~ (scheme ~ "://")? ~ domain ~ path? ~ query? ~ fragment? ~ EOI }

scheme = { "https" | "http" | "wss" | "ws" | "ftp" }

domain = { subdomain* ~ domain_name ~ tld }
subdomain = { (ASCII_ALPHANUMERIC | "-")+ ~ "." }
domain_name = { (ASCII_ALPHANUMERIC | "-")+ }
tld = { "." ~ (ASCII_ALPHA | ASCII_DIGIT)+ }

path = { "/" ~ path_segment* }
path_segment = { (ASCII_ALPHANUMERIC | "-" | "_" | "." | "~" | "!" | "$" | "&" | "'" | "(" | ")" | "*" | "+" | "," | ";" | "=" | ":" | "@")+ ~ "/"? }

query = { "?" ~ query_param ~ ("&" ~ query_param)* }
query_param = { query_key ~ ("=" ~ query_value)? }
query_key = { (ASCII_ALPHANUMERIC | "-" | "_" | ".")+ }
query_value = { (ASCII_ALPHANUMERIC | "-" | "_" | "." | "~" | "!" | "$" | "&" | "'" | "(" | ")" | "*" | "+" | "," | ";" | "=" | ":" | "@" | "/" | "%")* }

fragment = { "#" ~ (ASCII_ALPHANUMERIC | "-" | "_" | "." | "~" | "!" | "$" | "&" | "'" | "(" | ")" | "*" | "+" | "," | ";" | "=" | ":" | "@" | "/" | "%")* }

// Reddit-specific patterns
reddit_url = { SOI ~ (scheme ~ "://")? ~ reddit_domain ~ reddit_path ~ query? ~ fragment? ~ EOI }
reddit_domain = { ("www.")? ~ "reddit.com" }
reddit_path = { "/" ~ (("r/" ~ subreddit_name ~ reddit_post?) | ("u/" ~ username) | ("user/" ~ username)) }
reddit_post = { "/comments/" ~ post_id ~ ("/" ~ post_slug ~ ("/" ~ comment_id)?)? }
subreddit_name = { (ASCII_ALPHANUMERIC | "_")+ }
username = { (ASCII_ALPHANUMERIC | "_" | "-")+ }
post_id = { (ASCII_ALPHANUMERIC)+ }
post_slug = { (ASCII_ALPHANUMERIC | "_" | "-")+ }
comment_id = { (ASCII_ALPHANUMERIC)+ }

// YouTube-specific patterns
youtube_url = { SOI ~ (scheme ~ "://")? ~ youtube_domain ~ youtube_path ~ query? ~ fragment? ~ EOI }
youtube_domain = { ("www.")? ~ ("youtube.com" | "youtu.be" | "m.youtube.com") }
youtube_path = { 
    ("/" ~ "watch" ~ youtube_watch_query) |
    ("/" ~ "v/" ~ video_id) |
    ("/" ~ "embed/" ~ video_id) |
    ("/" ~ "channel/" ~ channel_id) |
    ("/" ~ "c/" ~ channel_name) |
    ("/" ~ "@" ~ channel_handle) |
    ("/" ~ "playlist" ~ youtube_playlist_query) |
    ("/" ~ video_id)  // For youtu.be format
}
youtube_watch_query = { "?" ~ "v=" ~ video_id ~ ("&" ~ query_param)* }
youtube_playlist_query = { "?" ~ "list=" ~ playlist_id ~ ("&" ~ query_param)* }
video_id = { (ASCII_ALPHANUMERIC | "-" | "_")+ }
channel_id = { (ASCII_ALPHANUMERIC | "-" | "_")+ }
channel_name = { (ASCII_ALPHANUMERIC | "-" | "_")+ }
channel_handle = { (ASCII_ALPHANUMERIC | "-" | "_")+ }
playlist_id = { (ASCII_ALPHANUMERIC | "-" | "_")+ }

// Twitter-specific patterns
twitter_url = { SOI ~ (scheme ~ "://")? ~ twitter_domain ~ twitter_path ~ query? ~ fragment? ~ EOI }
twitter_domain = { ("www.")? ~ ("twitter.com" | "x.com") }
twitter_path = { "/" ~ username ~ ("/" ~ "status" ~ "/" ~ tweet_id)? }
tweet_id = { (ASCII_DIGIT)+ }

// GitHub-specific patterns
github_url = { SOI ~ (scheme ~ "://")? ~ github_domain ~ github_path ~ query? ~ fragment? ~ EOI }
github_domain = { ("www.")? ~ "github.com" }
github_path = { "/" ~ github_username ~ ("/" ~ github_repo ~ github_repo_path?)? }
github_username = { (ASCII_ALPHANUMERIC | "-" | "_")+ }
github_repo = { (ASCII_ALPHANUMERIC | "-" | "_" | ".")+ }
github_repo_path = { 
    ("/" ~ "issues" ~ ("/" ~ issue_number)?) |
    ("/" ~ "pull" ~ ("/" ~ pr_number)?) |
    ("/" ~ "tree" ~ "/" ~ branch_name) |
    ("/" ~ "blob" ~ "/" ~ branch_name ~ "/" ~ file_path) |
    ("/" ~ "commit" ~ "/" ~ commit_hash)
}
issue_number = { (ASCII_DIGIT)+ }
pr_number = { (ASCII_DIGIT)+ }
branch_name = { (ASCII_ALPHANUMERIC | "-" | "_" | ".")+ }
commit_hash = { (ASCII_ALPHANUMERIC)+ }
file_path = { path_segment+ }