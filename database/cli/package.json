{
  "name": "sorter-db-cli",
  "version": "1.0.0",
  "description": "CLI for managing Sorter database operations",
  "type": "module",
  "main": "index.ts",
  "bin": {
    "sorter-db": "./index.ts"
  },
  "files": [
    "index.ts",
    "commands/",
    "scripts/",
    "README.md"
  ],
  "scripts": {
    "dev": "bun run index.ts",
    "build": "bun build index.ts --outdir ./dist --target bun",
    "prepublishOnly": "bun run build",
    "postinstall": "bun run scripts/postinstall.ts",
    "install-deps": "bun run scripts/install-deps.ts",
    "check": "bun run scripts/check-deps.ts",
    "type-check": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "database",
    "postgresql",
    "migration",
    "docker",
    "cli"
  ],
  "author": "Sorter Team",
  "license": "MIT",
  "engines": {
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "dotenv": "^17.2.2",
    "envfile": "^7.1.0",
    "pm2": "^6.0.11",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  }
}
