# Environment Type (development, staging, production)
ENVIRONMENT=production

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secure_password_here
POSTGRES_DB=sorter

# Development Mode
NODE_ENV=production
IS_DOCKER=true

# Hostname Configuration
HOSTNAME=sorter.example.com

# Logging Configuration
BORTER_LOG_PATH=/app/borter/logs
BORTER_LOG_LEVEL=info

# REPL Configuration
REPL_PASSWORD=secure_repl_password_here

# Linear Integration
VITE_LINEAR_CLIENT_ID=
BORTER_LINEAR_CLIENT_ID=
BORTER_LINEAR_CLIENT_SECRET=

# Spotify Integration
VITE_SPOTIFY_CLIENT_ID=
BORTER_SPOTIFY_CLIENT_ID=
BORTER_SPOTIFY_CLIENT_SECRET=

# Reddit Integration
BORTER_REDDIT_CLIENT_ID=
BORTER_REDDIT_SECRET=

# Twitter Integration
BORTER_TWITTER_KEY=
BORTER_TWITTER_KEY_SECRET=
BORTER_TWITTER_BEARER_TOKEN=
BORTER_TWITTER_OAUTH_CLIENTID=
BORTER_TWITTER_OAUTH_CLIENTSECRET=

# YouTube Integration
VITE_YOUTUBE_CLIENT_ID=
BORTER_YOUTUBE_API_KEY=
BORTER_YOUTUBE_CLIENT_ID=
BORTER_YOUTUBE_CLIENT_SECRET=
BORTER_YOUTUBE_REDIRECT_URIS=https://sorter.example.com/auth/youtube/callback
BORTER_YOUTUBE_JAVASCRIPT_ORIGINS=https://sorter.example.com

# Email Integration
BORTER_SENDGRID_API_KEY=

# Admin Configuration
BORTER_STATIC_ADMINS=admin
BORTER_STATIC_API_KEYS=secure_api_key_here

# Discord Integration (for rustsorter)
DISCORD_TOKEN=

# Production Features
AUTO_LOGIN=false
NO_RATE_LIMITS=false

# API URLs
VITE_API_URL=https://sorter.example.com 