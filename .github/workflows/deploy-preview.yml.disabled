# .github/workflows/deploy-preview.yml
name: Deploy Preview

on:
  pull_request:
    types: [opened, synchronize, reopened, closed]

# Ensures only one deployment runs per PR at a time
concurrency:
  group: deploy-preview-${{ github.head_ref }}
  cancel-in-progress: true

jobs:
  deploy_preview_app:
    name: Deploy Preview App
    runs-on: [self-hosted, texas, jason]


    environment:
        name: pr-${{ github.event.number }}
        url: ${{ steps.deploy.outputs.url }}

    permissions:
      contents: read
      pull-requests: write # Allows the action to comment on the PR

    steps:
      - name: Install dependencies
        run: sudo apt-get update

      - name: Checkout Code
        uses: actions/checkout@v4

      # Compute a sanitized Neon branch name (lowercase, non-alnum -> '-')
      - name: Compute Neon branch name
        id: compute_branch
        run: |
          BRANCH_NAME=$(echo "${{ github.head_ref }}" | sed 's/[^a-zA-Z0-9]/-/g' | tr '[:upper:]' '[:lower:]' | cut -c1-50)
          echo "branch_name=$BRANCH_NAME" >> "$GITHUB_OUTPUT"

      # Create or reuse Neon branch via official action
      - name: Create Neon Branch
        if: github.event.action != 'closed'
        id: neon_create
        uses: neondatabase/create-branch-action@v6
        with:
          project_id: ${{ secrets.NEON_PROJECT_ID }}
          branch_name: ${{ steps.compute_branch.outputs.branch_name }}
          parent_branch: ${{ secrets.NEON_MAIN_BRANCH_NAME }}
          api_key: ${{ secrets.NEON_API_KEY }}

      # Setup Python/UV and install dependencies
      - name: Set up Python and UV
        if: github.event.action != 'closed'
        uses: astral-sh/setup-uv@v4
        with:
          python-version: "3.11"

      - name: Install project dependencies
        if: github.event.action != 'closed'
        run: uv sync

      # Run DB migrations against the branch
      - name: Run DB migrations
        if: github.event.action != 'closed'
        run: |
          sudo curl -fsSL -o /usr/local/bin/dbmate https://github.com/amacneil/dbmate/releases/latest/download/dbmate-linux-amd64
          sudo chmod +x /usr/local/bin/dbmate
          uv run main.py migrate
        env:
          DATABASE_URL: ${{ steps.neon_create.outputs.db_url }}

      - name: Deploy or Cleanup Preview App on Fly.io
        id: deploy
        uses: superfly/fly-pr-review-apps@1.5.0
        env:
          FLY_API_TOKEN: ${{ secrets.FLY_API_TOKEN }}
        with:
          # This action automatically detects if the PR is open or closed.
          # If open, it deploys. If closed, it destroys the app.
          # Provide DATABASE_URL, STEAM_API_KEY, and Spotify secrets to the runtime as Fly secrets
          secrets: |
            DATABASE_URL=${{ steps.neon_create.outputs.db_url }}
            STEAM_API_KEY=${{ secrets.STEAM_API_KEY }}
            SPOTIFY_CLIENT_ID=${{ secrets.SPOTIFY_CLIENT_ID }}
            SPOTIFY_CLIENT_SECRET=${{ secrets.SPOTIFY_CLIENT_SECRET }}

      # Wait until the deployed app responds healthy
      - name: Wait for app health
        if: github.event.action != 'closed'
        run: |
          set -euo pipefail
          APP_URL='${{ steps.deploy.outputs.url }}'
          echo "Waiting for ${APP_URL}/api/health ..."
          for i in {1..60}; do
            if curl -fsS "${APP_URL}/api/health" > /dev/null; then
              echo "App is healthy"; exit 0;
            fi
            sleep 2
          done
          echo "App did not become healthy in time" >&2
          exit 1

      - name: Install babashka (curl installer)
        if: github.event.action != 'closed'
        shell: bash
        run: |
          set -euo pipefail
          bash < <(curl -s https://raw.githubusercontent.com/babashka/babashka/master/install)
          bb --version

      - name: Clone TF2 seed repo
        if: github.event.action != 'closed'
        run: |
          set -euo pipefail
          mkdir -p seed
          rm -rf seed/sorter-tf2 || true
          git clone https://github.com/sorterisntonline/sorter-tf2 seed/sorter-tf2

      - name: Seed database with TF2 dataset (bb)
        if: github.event.action != 'closed'
        run: |
          set -euo pipefail
          SORTER_API_KEY=STATIC_TEST_KEY_FOR_ADMIN_USER_123 SORTER_API_BASE_URL='${{ steps.deploy.outputs.url }}/api' bb seed/sorter-tf2/compiler.clj

      - name: Cleanup Neon Database Branch
        if: github.event.action == 'closed'
        uses: neondatabase/delete-branch-action@v3
        with:
          project_id: ${{ secrets.NEON_PROJECT_ID }}
          branch: ${{ steps.compute_branch.outputs.branch_name }}
          api_key: ${{ secrets.NEON_API_KEY }}
