{
  "name": "Sorter Development Environment",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "fborter",
  "workspaceFolder": "/app",
  "forwardPorts": [3000, 7888, 8080, 5432],
  "remoteUser": "root",
  "customizations": {
    "vscode": {
      "extensions": [
        "betterthantomorrow.calva",
        "matklad.rust-analyzer",
        "tamasfe.even-better-toml",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
          "source.fixAll.eslint": true
        },
        "calva.replConnectSequences": [
          {
            "name": "Borter REPL",
            "host": "localhost",
            "port": 7888
          }
        ],
        "calva.myCLJSReplConnectSequence": {
          "name": "Borter REPL",
          "host": "localhost",
          "port": 7888
        },
        "files.watcherExclude": {
          "**/target/**": true,
          "**/node_modules/**": true,
          "**/dist/**": true,
          "**/.git/**": true
        },
        "rust-analyzer.checkOnSave.extraArgs": ["--target-dir", "/usr/src/app/target"]
      }
    }
  },
  "postCreateCommand": "echo 'Dev container is ready!'"
} 