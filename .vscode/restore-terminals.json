{
    "artificialDelayMilliseconds": 700,
    "keepExistingTerminalsOpen": false,
    "runOnStartup": true,
    "terminals": [
      {
        "splitTerminals": [
          {
            "name": "database",
            "commands": [
              "cd borter/database",
              "./run-postgres.sh"
            ]
          }
        ]
      },
      {
        "splitTerminals": [
          {
            "name": "borter",
            "commands": [
              "cd borter",
              "./run.sh"
            ]
          }
        ]
      },
      {
        "splitTerminals": [
          {
            "name": "rustsorter",
            "commands": [
              "cd rustsorter",
              "cargo run"
            ]
          }
        ]
      },
      {
        "splitTerminals": [
          {
            "name": "forter",
            "commands": [
              "cd forter",
              "npm install",
              "npm run dev"
            ]
          }
        ]
      }
    ]
  }