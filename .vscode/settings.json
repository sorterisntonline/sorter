    "calva.replConnectSequences": [
        {
            "name": "Borter REPL",
            "projectType": "deps.edn",
            "nReplPortFile": [".calva", "repl.calva-repl"],
            "connectionType": "nrepl",
            "autoSelectNs": true,
            "customJackInCommandLine": "(cd borter; clojure -Sdeps '{:deps {nrepl/nrepl {:mvn/version,\"1.1.1\"},cider/cider-nrepl {:mvn/version,\"0.47.1\"}}}' -M -m nrepl.cmdline --middleware \"[cider.nrepl/cider-middleware]\")",
            "hosts": [
                {
                    "host": "localhost",
                    "port": 7888
                }
            ]
        }
    ]
}