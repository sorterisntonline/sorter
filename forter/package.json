{
  "name": "forter",
  "private": true,
  "version": "1.5.0",
  "type": "module",
  "scripts": {
    "build": "node scripts/update-env.js $ENVIRONMENT && vite build --mode $ENVIRONMENT",
    "dev": "export ENVIRONMENT=development && vite build --mode development --watch ",
    "dev:client": "echo 'starting client-only dev server' && ENVIRONMENT=development vite",
    "development": "ENVIRONMENT=development npm run build --mode development",
    "staging": "cross-env ENVIRONMENT=staging npm run build",
    "production": "cross-env ENVIRONMENT=production npm run generate-sitemap && npm run build",
    "test:staging": "ENVIRONMENT=staging node scripts/update-env.js staging && echo 'Staging environment setup complete - verify your files'",
    "test:production": "ENVIRONMENT=production node scripts/update-env.js production && node scripts/generate-sitemap.js && echo 'Production environment setup complete - verify your files'",
    "test:cleanup": "git checkout . && git clean -fd",
    "lint": "eslint .",
    "preview": "vite preview",
    "generate-sitemap": "node scripts/generate-sitemap.js"
  },
  "dependencies": {
    "@auth0/auth0-react": "^2.3.0",
    "@heroicons/react": "^2.2.0",
    "@preact/signals-react": "^1.3.8",
    "chart.js": "^4.4.7",
    "chartjs-plugin-datalabels": "^2.2.0",
    "chartjs-plugin-zoom": "^2.2.0",
    "d3": "^7.9.0",
    "framer-motion": "^12.4.2",
    "highlight.js": "^11.11.1",
    "ignore": "^7.0.3",
    "katex": "^0.16.21",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.3",
    "react-router-dom": "^7.1.5",
    "react-select": "^5.10.0",
    "react-twitter-widgets": "^1.11.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "styled-components": "^6.1.15",
    "swr": "^2.3.2",
    "three": "^0.173.0",
    "wouter": "^2.12.1"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/node": "^22.13.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.173.0",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "date-fns": "^4.1.0",
    "eslint": "^9.20.1",
    "eslint-config-typescript": "^3.0.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "postcss": "^8.5.2",
    "prettier": "3.1.0",
    "sitemap": "^8.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.2.1"
  }
}
