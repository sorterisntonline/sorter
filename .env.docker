# Environment Type (development, staging, production)
ENVIRONMENT=development

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=db

# Development Mode
NODE_ENV=development
IS_DOCKER=true

# Hostname Configuration
HOSTNAME=localhost

# Logging Configuration (Development)
BORTER_LOG_PATH=./logs
BORTER_LOG_LEVEL=debug

# REPL Configuration
REPL_PASSWORD=dev_password

# Linear Integration
VITE_LINEAR_CLIENT_ID=
BORTER_LINEAR_CLIENT_ID=
BORTER_LINEAR_CLIENT_SECRET=

# Spotify Integration
VITE_SPOTIFY_CLIENT_ID=
BORTER_SPOTIFY_CLIENT_ID=
BORTER_SPOTIFY_CLIENT_SECRET=

# Reddit Integration
BORTER_REDDIT_CLIENT_ID=
BORTER_REDDIT_SECRET=

# Twitter Integration
BORTER_TWITTER_KEY=
BORTER_TWITTER_KEY_SECRET=
BORTER_TWITTER_BEARER_TOKEN=
BORTER_TWITTER_OAUTH_CLIENTID=
BORTER_TWITTER_OAUTH_CLIENTSECRET=

# YouTube Integration
VITE_YOUTUBE_CLIENT_ID=
BORTER_YOUTUBE_API_KEY=
BORTER_YOUTUBE_CLIENT_ID=
BORTER_YOUTUBE_CLIENT_SECRET=
BORTER_YOUTUBE_REDIRECT_URIS=http://localhost:3000/auth/youtube/callback
BORTER_YOUTUBE_JAVASCRIPT_ORIGINS=http://localhost:3000

# Email Integration
BORTER_SENDGRID_API_KEY=

# Admin Configuration
BORTER_STATIC_ADMINS=admin
BORTER_STATIC_API_KEYS=dev_api_key

# Discord Integration (for rustsorter)
DISCORD_TOKEN=

# Development Features
AUTO_LOGIN=true
NO_RATE_LIMITS=false

# API URLs
VITE_API_URL=http://localhost:3000 